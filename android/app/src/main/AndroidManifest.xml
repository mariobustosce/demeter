<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Avisos push. En Android 13+ se pide al activar la primera alerta. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- El fondo animado es opcional: sin esto Play no oculta la app a los
         teléfonos que no lo admiten. La app lo consulta antes de ofrecerlo. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <!-- Sin backup: las prefs llevan coordenadas y el almacén seguro el token.
         allowBackup apaga la nube (y en Android 11 o menos, todo); las reglas
         cubren el paso a otro teléfono en Android 12+. -->
    <application
        android:label="WindowsDemeter"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- TODO(admob): este es el App ID de PRUEBA de Google. Reemplazar por
             el App ID real antes de publicar, junto con los Ad Unit ID de
             lib/config/ads_config.dart. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
        <!-- Push de los avisos. El canal lo crea la app al arrancar; el id es
             el que manda el servidor (APP_PUSH_CANAL_ANDROID) y el de
             lib/services/push_service.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alertas" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacion" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificacion" />
        <!-- Sin token de FCM hasta que hay sesión: la app lo pide al entrar y
             lo borra al salir. Un invitado no tiene. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- assetsPaths: al cambiar el fondo, Android 12+ recalcula los colores
             del sistema (Material You) y relanzaba la actividad. El relanzamiento
             destruía el motor de Flutter y la app arrancaba de nuevo. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode|assetsPaths"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- El fondo animado, en su propio proceso: pauseTimers() pausa todos
             los WebView del proceso, y en el de la app pausaría el mapa. -->
        <service
            android:name=".CelestialWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="WindowsDemeter"
            android:process=":fondo"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/celestial_wallpaper" />
        </service>
        
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
